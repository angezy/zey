<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Submit Your Property Listing</title>
  <meta name="description"
    content="listing your deal.">
  <meta name="keywords"
    content="listing your deal to close it fast">
  <meta name="author" content="Nick's Real Estate Services">
  <meta name="robots" content="index, follow">
  <!-- Font Awesome -->
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet" />
  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet" />
  <!-- MDB -->
  <link
  href="https://cdnjs.cloudflare.com/ajax/libs/mdb-ui-kit/8.2.0/mdb.min.css"
  rel="stylesheet"
/>

  <link rel="stylesheet" href="/public/css/mdb.min.css" />
  <link rel="stylesheet" href="/assets/css/cs.css">
</head>

<body>
  <section id="bg">
    <div class="container py-5">
      <div class="row d-flex align-items-center justify-content-center">

        <p class="text-muted  text-center">.</p>

        <div class="col-md-6">
          <div class=" border  shadow-0 mb-3 glass-card" style="width: 100%;">
            <div class="card-body rounded-4 text-light px-5 pt-4 pb-2">
              <h2 class="text-center">Submit Your Property Listing</h2>
              <form id="listingForm" class="text-center" action="/api/listing" method="POST" enctype="multipart/form-data">
                <div data-mdb-input-init class="form-outline mb-4">
                  <input id="Title" name="Title" type="text" class="form-control"  />
                  <label class="form-label" for="Title">Title*</label>
                </div>
                <div data-mdb-input-init class="form-outline mb-4">
                  <input id="FullName" name="FullName" type="text" class="form-control"  />
                  <label class="form-label" for="FullName">Full Name*</label>
                </div>
                <div data-mdb-input-init class="form-outline mb-4">
                  <input id="Email" name="Email" type="email" class="form-control"  />
                  <label class="form-label" for="Email">Email*</label>
                </div>
                <div data-mdb-input-init class="form-outline mb-4">
                  <input id="Phone" name="Phone" type="tel" class="form-control"  />
                  <label class="form-label" for="Phone">Phone Number*</label>
                </div>
                <div data-mdb-input-init class="form-outline mb-4">
                  <input id="PropertyAddress" name="PropertyAddress" type="text" class="form-control"  />
                  <label class="form-label" for="PropertyAddress">Property Address*</label>
                </div>
                <div data-mdb-input-init class="form-outline mb-4">
                  <select id="PropertyType" name="PropertyType" class="text-dark form-control" >
                    <option value=""></option>
                    <option value="Single Family Home">Single Family Home</option>
                    <option value="Multi Family">Multi Family</option>
                    <option value="Condo">Condo</option>
                    <option value="Townhouse">Townhouse</option>
                    <option value="Apartment">Apartment</option>
                    <option value="Triplex">Triplex</option>
                    <option value="Fourplex">Fourplex</option>
                    <option value="Other">Other</option>
                  </select>
                  <label class="form-label" for="PropertyType">Property Type*</label>
                </div>
                <div data-mdb-input-init class="form-outline mb-4">
                  <input id="Bedrooms" name="Bedrooms" type="number" class="form-control"  />
                  <label class="form-label" for="Bedrooms">Number of Bedrooms*</label>
                </div>
                <div data-mdb-input-init class="form-outline mb-4">
                  <input id="Bathrooms" name="Bathrooms" type="number" class="form-control"  />
                  <label class="form-label" for="Bathrooms">Number of Bathrooms*</label>
                </div>

                <div data-mdb-input-init class="form-outline mb-4">
                  <input id="AskingPrice" name="AskingPrice" type="number" class="form-control"  />
                  <label class="form-label" for="AskingPrice">Asking Price*</label>
                </div>
                <div data-mdb-input-init class="form-outline mb-4">
                  <textarea id="Description" name="Description" class="form-control" rows="3" ></textarea>
                  <label class="form-label" for="Description">Description*</label>
                </div>
                <div data-mdb-input-init class="form-outline mb-4">
                  <input id="ReasonForSelling" name="ReasonForSelling" type="text" class="form-control"  />
                  <label class="form-label" for="ReasonForSelling">Reason for Selling</label>
                </div>
                <div data-mdb-input-init class="form-outline mb-4">
                  <input id="PhotoFile" name="PhotoFile" type="file" 
                  class="form-control" accept="image/*"  />
                  <label class="form-label" for="PhotoFile"></label>
                </div>
                <div data-mdb-input-init class="form-outline mb-4">
                  <input id="PhotoURL" name="PhotoURL" type="url" class="form-control" />
                  <label class="form-label" for="PhotoURL">Photo URL</label>
                </div>
                <div data-mdb-input-init class="form-outline mb-4">
                  <input id="LotArea" name="LotArea" type="number" class="form-control"  />
                  <label class="form-label" for="LotArea">Lot Area (SQ FT)</label>
                </div>
                <div data-mdb-input-init class="form-outline mb-4">
                  <input id="FloorArea" name="FloorArea" type="number" class="form-control"  />
                  <label class="form-label" for="FloorArea">Floor Area (SQ FT)</label>
                </div>
                <div data-mdb-input-init class="form-outline mb-4">
                  <input id="YearBuilt" name="YearBuilt" type="number" class="form-control"  />
                  <label class="form-label" for="YearBuilt">Year Built</label>
                </div>
                <div data-mdb-input-init class="form-outline mb-4">
                  <input id="Garage" name="Garage" type="number" class="form-control"  />
                  <label class="form-label" for="Garage">Garage</label>
                </div>
                <div data-mdb-input-init class="form-outline mb-4">
                  <input id="Stories" name="Stories" type="number" class="form-control"  />
                  <label class="form-label" for="Stories">Stories</label>
                </div>
                <div data-mdb-input-init class="form-outline mb-4">
                  <input id="Roofing" name="Roofing" type="text" class="form-control"  />
                  <label class="form-label" for="Roofing">Roofing</label>
                </div>
                <div data-mdb-input-init class="form-outline mb-4">
                  <input id="Comps1" name="Comps1" type="text" class="form-control" />
                  <label class="form-label" for="Comps1">Comps1</label>
                </div>
                <div data-mdb-input-init class="form-outline mb-4">
                  <input id="Comps2" name="Comps2" type="text" class="form-control" />
                  <label class="form-label" for="Comps2">Comps2</label>
                </div>
                <div data-mdb-input-init class="form-outline mb-4">
                  <input id="Comps3" name="Comps3" type="text" class="form-control" />
                  <label class="form-label" for="Comps3">Comps3</label>
                </div>
                <button type="submit" class="btn btn-primary">Submit Listing</button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <!-- MDB -->
<script
  type="text/javascript"
  src="https://cdnjs.cloudflare.com/ajax/libs/mdb-ui-kit/8.2.0/mdb.umd.min.js"
></script>

  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <!-- Core JS Files -->
  <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
  <script src="/assets/js/listing.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
  <script>
    document.getElementById('listingForm').addEventListener('submit', async function (event) {
      event.preventDefault();
      const formData = new FormData(this);

      try {
        const response = await fetch('/api/listing', {
          method: 'POST',
          body: formData
        });

        const result = await response.json();
        if (result.success) {
          window.location.href = `${window.location.href.split('?')[0]}?success=${encodeURIComponent(result.message)}`;
        } else {
          window.location.href = `${window.location.href.split('?')[0]}?errors=${encodeURIComponent(result.message)}`;
        }
      } catch (error) {
        console.error('Error submitting form:', error);
        window.location.href = `${window.location.href.split('?')[0]}?errors=${encodeURIComponent('Error submitting form')}`;
      }
    });
  </script>
</body>

</html>