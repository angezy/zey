<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">


</head>

<body class="">
	{{> __newnav}}



	<section class=" hero-wrap hero-wrap-2 ftco-degree-bg js-fullheight"
		style="background-image: url('public/images/bg_1.jpg');" >
		<div class="overlay"></div>
		<div class="overlay-2"></div>
		<div class="container">
			<div class="row no-gutters slider-text js-fullheight align-items-end justify-content-center">
				<div class="col-md-9 ftco-animate pb-5 mb-5 text-center">
					<h1 class="mb-3 bread">Available Properties</h1>
					<p class="breadcrumbs"><span class="mr-2"><a href="/">Home <i
									class="ion-ios-arrow-forward"></i></a></span>
						<span class="mr-2"><a href="/Properties">Properties<i
									class="ion-ios-arrow-forward"></i></a></span>
					</p>
				</div>
			</div>
		</div>
	</section>

	<section class="ftco-section goto-here">
		<div class="container">
			<div class="row">
				{{#each property}}
				<div class="col-md-4">
					<div class="property-wrap ftco-animate">
						<div class="img d-flex align-items-center justify-content-center"
							style="background-image: url({{this.PhotoFile}});">
							<a href="/property/{{this.listingId}}"
								class="icon d-flex align-items-center justify-content-center btn-custom">
								<span class="ion-ios-link"></span>
							</a>



							<div class="list-agent d-flex align-items-center">
								<a href="#" class="agent-info d-flex align-items-center">
									<div class="img-2 rounded-circle"
										style="background-image: url(public/images/person_1.jpg);"></div>
									<h3 class="mb-0 ml-2">Nick Farahmand</h3>
								</a>
								<div class="tooltip-wrap d-flex">
									<a href="#" class="icon-2 d-flex align-items-center justify-content-center"
										data-toggle="tooltip" data-placement="top" title="Bookmark">
										<span class="ion-ios-heart"><i class="sr-only">Bookmark</i></span>
									</a>
									<a href="#" class="icon-2 d-flex align-items-center justify-content-center"
										data-toggle="tooltip" data-placement="top" title="Compare">
										<span class="ion-ios-eye"><i class="sr-only">Compare</i></span>
									</a>
								</div>
							</div>
						</div>
						<div class="text">
							<p class="price mb-3"><span class="orig-price">${{this.AskingPrice}}</span></p>
							<h3 class="mb-0"><a href="/property/{{this.listingId}}">{{this.Title}}</a></h3>
							<span class="location d-inline-block mb-3"><i
									class="ion-ios-pin mr-2"></i>{{this.PropertyAddress}}</span>
							<ul class="property_list">
								<li><span class="flaticon-bed"></span>{{this.Bedrooms}}</li>
								<li><span class="flaticon-bathtub"></span>{{this.Bathrooms}}</li>
								<li><span class="flaticon-floor-plan"></span>{{this.SquareFootage}} sqft</li>
							</ul>
						</div>
					</div>
				</div>
				{{/each}}
			</div>


			<div class="row mt-5">
				<div class="col text-center">
					<div class="block-27">
						<ul>
							<li><a href="#">&lt;</a></li>
							<li class="active"><span>1</span></li>
							<li><a href="#">2</a></li>
							<li><a href="#">3</a></li>
							<li><a href="#">4</a></li>
							<li><a href="#">5</a></li>
							<li><a href="#">&gt;</a></li>
						</ul>
					</div>
				</div>
			</div>
		</div>
	</section>
	{{> __newfooter}}


</body>

</html>